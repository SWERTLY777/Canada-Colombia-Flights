{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {"contentSize": "780px", "wideSize": "1220px"},
    "color": {"palette": [
      {"slug":"navy","name":"Casa Andina Navy","color":"#1B3C53"},
      {"slug":"deep-navy","name":"Deep Navy","color":"#102B3E"},
      {"slug":"gold","name":"Andean Gold","color":"#D7A645"},
      {"slug":"terracotta","name":"Terracotta","color":"#B75E44"},
      {"slug":"brick","name":"Brick Red","color":"#9E3F29"},
      {"slug":"cream","name":"Warm Cream","color":"#F3F2E7"},
      {"slug":"sand","name":"Soft Sand","color":"#D9CAA5"},
      {"slug":"white","name":"White","color":"#FFFFFF"}
    ]},
    "typography": {"fontFamilies": [{"fontFamily":"Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif","slug":"system","name":"Modern System"}]},
    "spacing": {"units":["px","rem","vw","vh","%"]}
  },
  "styles": {
    "color": {"background":"#F7F5EE","text":"#1B3C53"},
    "typography": {"fontFamily":"var(--wp--preset--font-family--system)","lineHeight":"1.65"},
    "elements": {"heading":{"typography":{"fontWeight":"750","lineHeight":"1.08"}},"link":{"color":{"text":"#9E3F29"}}}
  }
}
